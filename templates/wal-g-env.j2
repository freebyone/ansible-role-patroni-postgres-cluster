# WAL-G S3 Configuration
WALG_S3_PREFIX={{ wal_g_s3_prefix }}
AWS_ACCESS_KEY_ID={{ wal_g_aws_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ wal_g_aws_secret_access_key }}
AWS_REGION={{ wal_g_aws_region | default('rus-1') }}
{% if wal_g_aws_endpoint | default('') %}
AWS_ENDPOINT={{ wal_g_aws_endpoint }}
{% endif %}

# Backup settings
WALG_COMPRESSION_METHOD={{ wal_g_compression_method | default('lz4') }}
WALG_DELTA_MAX_STEPS={{ wal_g_delta_max_steps | default(7) }}
WALG_PREVENT_WAL_OVERWRITE=true

# Performance
WALG_UPLOAD_CONCURRENCY={{ wal_g_upload_concurrency | default(4) }}
WALG_DOWNLOAD_CONCURRENCY={{ wal_g_download_concurrency | default(4) }}
WALG_UPLOAD_DISK_CONCURRENCY={{ wal_g_upload_disk_concurrency | default(2) }}

# Logging
WALG_LOG_LEVEL=INFO